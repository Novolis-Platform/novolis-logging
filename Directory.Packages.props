    <PackageVersion Include="Microsoft.FASTER.Core" Version="2.6.5" />
    <PackageVersion Include="Novolis.Agent.Core" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Agent.Surface" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Transports.LocalIpc" Version="2026.1.*" />
